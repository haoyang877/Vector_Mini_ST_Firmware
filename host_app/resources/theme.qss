QWidget { font-family: "Microsoft YaHei UI", "Segoe UI"; font-size: 13px; color: #253450; }
QMainWindow, QWidget#workspace { background: #f2f5fa; }
QLabel#brandCompact { color: #183251; font-size: 21px; font-weight: 700; }
QLabel#globalStatus { color: #425775; }
QGroupBox { background: #ffffff; border: 1px solid #dce5f1; border-radius: 8px; margin-top: 12px; padding: 14px 12px 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 13px; padding: 0 5px; color: #345473; }
QPushButton { background: #ffffff; border: 1px solid #d7e1ef; border-radius: 6px; padding: 9px 17px; }
QPushButton:hover { background: #eff5ff; border-color: #6f97d1; }
QPushButton:disabled { color: #a5b0c0; background: #f4f6f9; border-color: #e3e8ef; }
QPushButton[role="primary"] { background: #2864c8; color: #ffffff; border: none; font-weight: 600; }
QPushButton[role="primary"]:hover { background: #2057b0; }
QPushButton[role="primary"]:disabled { background: #b5c7e2; color: #f8fbff; }
QPushButton[role="danger"] { background: #c84646; color: #ffffff; border: none; font-weight: 600; }
QPushButton[role="danger"]:disabled { background: #e4b7b7; color: #fff6f6; }
QLineEdit, QSpinBox { background: #ffffff; color: #243754; border: 1px solid #d6e0ed; border-radius: 5px; padding: 8px; min-height: 19px; }
QLineEdit:disabled { background: #f0f3f8; color: #9ba8bb; }
QTextEdit { background: #f8faff; color: #425775; border: 1px solid #e2e9f3; border-radius: 6px; padding: 7px; }
QProgressBar { border: none; border-radius: 5px; background: #e9eef6; min-height: 9px; max-height: 9px; }
QProgressBar::chunk { background: #3977d4; border-radius: 5px; }
QScrollArea { border: none; background: transparent; }
